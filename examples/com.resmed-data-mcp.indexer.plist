<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.resmed-data-mcp.indexer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>resmed-data-mcp</string>
    <string>indexer</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>REPLACE_ME_WITH_NPM_BIN_DIR:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/REPLACE_ME</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/resmed-data-mcp-indexer.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/resmed-data-mcp-indexer.err.log</string>
</dict>
</plist>
